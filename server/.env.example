GEMINI_API_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
KEITH_PASSWORD=
ANNA_PASSWORD=

# Optional - only read when SIMULATION_MODE=replay. Pins the baked replay to a specific
# recorded window instead of auto-selecting "the latest session" - see
# server/src/replay/replayEngine.ts.
# SIMULATION_MODE=replay
# REPLAY_WINDOW_START=2026-09-11T07:00:42.955Z
# REPLAY_WINDOW_HOURS=3.5

# Optional - only needed for running more than one "lab" locally at once (see README's
# "Multiple labs" section / `npm run dev:labs`). Defaults below match today's single-lab
# paths, so leave these unset for the normal single-lab `npm run dev` workflow.
# MAP_FILE=lab.json
# DB_FILE=lab.sqlite

# Optional - two of the Metrics dashboard's fixed labels (see socket/handlers.ts's
# productivity_open), overridable so different labs can show different snapshots.
# Defaults below match Lab 1's original values.
# PRODUCTIVITY_SCORE_LABEL=3% more productive than last week
# SIMULATION_MATCH_LABEL=Matching to 85%
